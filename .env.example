# Copy these into Vercel → Project → Settings → Environment Variables.
# Nothing here is read at build time; only the /api/send-inquiry function uses them.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where inquiries land. Defaults to sales@pulseglobaltrade.com
MAIL_TO=sales@pulseglobaltrade.com

# Optional. Defaults to Resend's shared sending domain, which works with no DNS
# setup. Once pulseglobaltrade.com is verified in Resend, switch this to an
# address on the domain so mail comes from the brand and lands in inboxes.
# MAIL_FROM=PulseGlobal Trade <sales@pulseglobaltrade.com>
